# このファイルをコピーして .env を作る。
#   cp .env.example .env
# .env は絶対に Git にコミットしない（.gitignore 済み）。
# 実際のキーは Slack 等の安全な手段でチームに共有する。

# --- 共通 ---
# development: 整形ログ（debug以上） / production: JSONログ（info以上）
NODE_ENV=development

# --- postgres（docker-compose 用） ---
POSTGRES_USER=shigotomikke
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=shigotomikke

# --- backend ---
# ローカル開発では上の POSTGRES_* と揃える（ホスト名は compose のサービス名 postgres）
DATABASE_URL=postgresql://shigotomikke:devpassword@postgres:5432/shigotomikke
REDIS_URL=redis://redis:6379

# 生徒のセッショントークン（JWT）の署名鍵。ローカルは適当な文字列でよい。本番は必ず変更する
SESSION_SECRET=change-me-in-local-dev

# Firebase Admin SDK（学校管理者の認証。サーバー側）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenRouter（サーバー側のみ。コース配布の共有キー。モデルは openai/gpt-oss-120b に確定。
# キーを生成AIやSNS・GitHub・Slack等に貼り付けない・共有しない）
OPENROUTER_API_KEY=

# Stripe（テストモード）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS 許可元（フロントのURL）
FRONTEND_URL=http://localhost:3000

# --- frontend（Firebase Web設定。管理者ログイン画面のみで使用） ---
# ブラウザに露出するため、NEXT_PUBLIC_ を付ける。秘密鍵は絶対に入れない
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
