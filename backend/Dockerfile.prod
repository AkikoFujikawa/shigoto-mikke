# 本番用（Render）。#75
# 開発用の Dockerfile（tsx watch）とは別に、ビルドしてから node で起動する。
# 本番最適化（multi-stage build で devDependencies を除く）は別 Issue で検討する。
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache openssl

RUN corepack enable

# devDependencies も入れる（本番 DB へのマイグレーションに prisma コマンドを使うため）
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm exec prisma generate
RUN pnpm build

ENV NODE_ENV=production
EXPOSE 4000

# 起動のたびに、本番 DB に未適用のマイグレーションを当ててから起動する（適用済みなら何もしない）
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/index.js"]